<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MidtermApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
    </style>

    <style name="Theme.MidtermApplication.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_system_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_coffee_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MidtermApplication</item>
        <item name="android:statusBarColor">@color/splash_system_background</item>
        <item name="android:navigationBarColor">@color/splash_system_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
