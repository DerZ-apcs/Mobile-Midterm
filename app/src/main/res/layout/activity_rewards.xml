<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/bottom_nav_content_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_2xl"
            android:paddingEnd="@dimen/screen_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:text="@string/rewards_title"
                android:textColor="@color/navy_rewards"
                android:textSize="@dimen/text_screen_title"
                android:textStyle="bold" />

            <!-- Loyalty Card -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    android:background="@drawable/bg_card_dark_rounded"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title + stamp count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/loyalty_card_title"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvRewardStampCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            tools:text="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stamp_total"
            android:textColor="@color/gray_400"
            android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- White stamp panel -->
                <LinearLayout
                    android:id="@+id/loyaltyStampPanel"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_loyalty_stamp_panel"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:weightSum="8">

                    <ImageView
                        android:id="@+id/imgStamp1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/coffee_cup_white" />

                    <ImageView
                        android:id="@+id/imgStamp2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/coffee_cup_white" />

                    <ImageView
                        android:id="@+id/imgStamp3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/coffee_cup_white" />

                    <ImageView
                        android:id="@+id/imgStamp4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/coffee_cup_white" />

                    <ImageView
                        android:id="@+id/imgStamp5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/coffee_cup_white" />

                    <ImageView
                        android:id="@+id/imgStamp6"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/coffee_cup_white" />

                    <ImageView
                        android:id="@+id/imgStamp7"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/coffee_cup_white" />

                    <ImageView
                        android:id="@+id/imgStamp8"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/coffee_cup_white" />

                </LinearLayout>

                <!-- Claim loyalty button -->
                <TextView
                    android:id="@+id/btnClaimLoyalty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_redeem_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:text="@string/cta_complete_loyalty"
                    android:textColor="@color/navy_rewards"
                    android:textSize="@dimen/text_secondary"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_2xl"
                android:background="@drawable/bg_card_dark_rounded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:alpha="0.9"
                        android:text="@string/my_points_label"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_secondary" />

                    <TextView
                        android:id="@+id/tvPointsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2750"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_screen_title"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnRedeemDrinks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_redeem_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:text="@string/cta_redeem_drinks"
                    android:textColor="@color/navy_rewards"
                    android:textSize="@dimen/text_secondary"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="@string/history_rewards_title"
                android:textColor="@color/navy_rewards"
                android:textSize="@dimen/text_toolbar_title"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRewardsHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_reward_history" />

            <TextView
                android:id="@+id/tvEmptyRewardHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/empty_reward_history"
                android:textColor="@color/text_gray_muted"
                android:textSize="@dimen/text_secondary"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        style="@style/Widget_CodeCup_BottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        app:menu="@menu/menu_primary_bottom_nav" />

</FrameLayout>
