<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/bottom_nav_content_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/greeting_morning"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_toolbar_title" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/coffee_dark"
                        android:textSize="@dimen/text_screen_title"
                        android:textStyle="bold"
                        tools:text="Anderson" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <ImageButton
                        android:id="@+id/btnCart"
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cart_desc"
                        android:padding="@dimen/spacing_xs"
                        android:src="@drawable/ic_cart"
                        android:tint="@color/coffee_dark" />

                    <TextView
                        android:id="@+id/tvCartBadge"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_cart_badge"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="3"
                        tools:visibility="visible" />

                </FrameLayout>

                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/profile_desc"
                    android:padding="@dimen/spacing_xs"
                    android:src="@drawable/ic_profile"
                    android:tint="@color/coffee_dark" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginEnd="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:background="@drawable/bg_card_dark_rounded"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/loyalty_card_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/tvStampCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        tools:text="4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stamp_total"
                        android:textColor="@color/gray_400"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="8">

                    <ImageView
                        android:id="@+id/imgStamp1"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stamp_icon_height"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:src="@drawable/coffee_cup_blue" />

                    <ImageView
                        android:id="@+id/imgStamp2"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stamp_icon_height"
                        android:layout_marginStart="@dimen/stamp_icon_gap"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:src="@drawable/coffee_cup_blue" />

                    <ImageView
                        android:id="@+id/imgStamp3"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stamp_icon_height"
                        android:layout_marginStart="@dimen/stamp_icon_gap"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:src="@drawable/coffee_cup_blue" />

                    <ImageView
                        android:id="@+id/imgStamp4"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stamp_icon_height"
                        android:layout_marginStart="@dimen/stamp_icon_gap"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:src="@drawable/coffee_cup_blue" />

                    <ImageView
                        android:id="@+id/imgStamp5"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stamp_icon_height"
                        android:layout_marginStart="@dimen/stamp_icon_gap"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:src="@drawable/coffee_cup_blue" />

                    <ImageView
                        android:id="@+id/imgStamp6"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stamp_icon_height"
                        android:layout_marginStart="@dimen/stamp_icon_gap"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:src="@drawable/coffee_cup_blue" />

                    <ImageView
                        android:id="@+id/imgStamp7"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stamp_icon_height"
                        android:layout_marginStart="@dimen/stamp_icon_gap"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:src="@drawable/coffee_cup_blue" />

                    <ImageView
                        android:id="@+id/imgStamp8"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stamp_icon_height"
                        android:layout_marginStart="@dimen/stamp_icon_gap"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:src="@drawable/coffee_cup_blue" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginEnd="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:background="@drawable/bg_card_dark_rounded"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:text="@string/choose_coffee_title"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCoffeeSearch"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/search_field_height"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:background="@drawable/bg_search_field"
                    android:hint="@string/search_coffee_hint"
                    android:inputType="text"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_secondary"
                    android:textColorHint="@color/gray_400" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCoffeeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_coffee_card"
                    tools:spanCount="2" />

                <TextView
                    android:id="@+id/tvEmptyCoffeeResults"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/empty_search_results"
                    android:textColor="@color/gray_400"
                    android:textSize="@dimen/text_secondary"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        style="@style/Widget_CodeCup_BottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:paddingTop="@dimen/bottom_nav_item_padding"
        android:paddingBottom="@dimen/bottom_nav_item_padding"
        app:itemIconSize="@dimen/icon_md"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_primary_bottom_nav" />

</FrameLayout>
