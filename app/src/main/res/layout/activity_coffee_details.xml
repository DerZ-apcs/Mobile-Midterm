<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_desc"
            android:padding="8dp"
            android:src="@drawable/arrow_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/details_title"
            android:textColor="@color/text_body"
            android:textSize="20sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageButton
                android:id="@+id/btnCart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/view_cart_desc"
                android:padding="8dp"
                android:src="@drawable/ic_cart" />

            <TextView
                android:id="@+id/tvCartBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_cart_badge"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />

        </FrameLayout>

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_product_image">

        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:contentDescription="@string/coffee_image_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_cup_outline" />

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCoffeeName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/coffee_americano"
                    android:textColor="@color/text_body"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDecreaseQty"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_gray"
                    android:clickable="true"
                    android:contentDescription="@string/decrease_qty_desc"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="@color/text_body"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="1"
                    android:textColor="@color/text_body"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnIncreaseQty"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_gray"
                    android:clickable="true"
                    android:contentDescription="@string/increase_qty_desc"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/text_body"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCoffeeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/coffee_description_placeholder"
                android:textColor="@color/gray_500"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCoffeePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:text="@string/coffee_price_placeholder"
                android:textColor="@color/brand_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOrderNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:backgroundTint="@color/brand_dark"
                android:hint="@string/order_note_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="120"
                android:maxLines="3"
                android:textColor="@color/text_body"
                android:textColorHint="@color/gray_500"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_shot"
                    android:textColor="@color/text_body"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="192dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segment_track"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/btnShotSingle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_active"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/shot_single"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnShotDouble"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/shot_double"
                        android:textColor="@color/gray_500"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_select_temp"
                    android:textColor="@color/text_body"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/btnHot"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_option_active"
                    android:padding="14dp"
                    android:src="@drawable/ic_hot"
                    android:tint="@color/brand_dark" />

                <ImageButton
                    android:id="@+id/btnCold"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_option_inactive"
                    android:padding="14dp"
                    android:src="@drawable/cold"
                    android:tint="@color/gray_400" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_size"
                    android:textColor="@color/text_body"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/btnSizeSmall"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_option_inactive"
                    android:padding="18dp"
                    android:src="@drawable/size_123"
                    android:tint="@color/gray_400" />

                <ImageButton
                    android:id="@+id/btnSizeMedium"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_option_active"
                    android:padding="14dp"
                    android:src="@drawable/size_123"
                    android:tint="@color/brand_dark" />

                <ImageButton
                    android:id="@+id/btnSizeLarge"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_option_inactive"
                    android:padding="8dp"
                    android:src="@drawable/size_123"
                    android:tint="@color/gray_400" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_ice"
                    android:textColor="@color/text_body"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/btnIceNone"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_option_inactive"
                    android:padding="14dp"
                    android:src="@drawable/ic_ice"
                    android:tint="@color/gray_400" />

                <ImageButton
                    android:id="@+id/btnIceLight"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_option_inactive"
                    android:padding="14dp"
                    android:src="@drawable/ic_ice"
                    android:tint="@color/gray_400" />

                <ImageButton
                    android:id="@+id/btnIceFull"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_option_active"
                    android:padding="14dp"
                    android:src="@drawable/ic_ice"
                    android:tint="@color/brand_dark" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface"
        android:orientation="vertical"
        android:padding="32dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="@color/gray_100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_total_amount"
                android:textColor="@color/gray_800"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_body"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="$3.00" />

        </LinearLayout>

        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="@string/cta_add_to_cart"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
