<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_marginStart="-8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back_desc"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/arrow_left" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:text="@string/checkout_title"
                android:textColor="@color/text_navy_heading"
                android:textSize="@dimen/text_page_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/checkout_delivery_address"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDeliveryAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:backgroundTint="@color/input_tint"
                android:gravity="top"
                android:hint="@string/checkout_delivery_address_hint"
                android:inputType="textMultiLine|textPostalAddress"
                android:minLines="3"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/checkout_promo_code"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPromoCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/input_tint"
                    android:hint="@string/checkout_promo_code_hint"
                    android:inputType="textCapCharacters"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_secondary" />

                <TextView
                    android:id="@+id/btnApplyPromo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:background="@drawable/bg_redeem_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:text="@string/checkout_apply_promo"
                    android:textColor="@color/navy_rewards"
                    android:textSize="@dimen/text_secondary"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPromoMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                tools:text="Promo applied" />

            <CheckBox
                android:id="@+id/cbUseLoyaltyReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xs"
                android:text="@string/checkout_use_free_drink"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/tvLoyaltyRewardHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:text="@string/checkout_loyalty_unavailable"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/checkout_delivery_time"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgDeliveryTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbDeliveryAsap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/checkout_delivery_asap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_secondary" />

                <RadioButton
                    android:id="@+id/rbDeliveryScheduled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_delivery_scheduled"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_secondary" />

            </RadioGroup>

            <LinearLayout
                android:id="@+id/layoutScheduledControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/btnSelectDeliveryDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_redeem_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/spacing_sm"
                    android:text="@string/checkout_select_date"
                    android:textColor="@color/text_on_light"
                    android:textSize="@dimen/text_secondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSelectDeliveryTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_redeem_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/spacing_sm"
                    android:text="@string/checkout_select_time"
                    android:textColor="@color/text_on_light"
                    android:textSize="@dimen/text_secondary"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDeliveryTimeMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:textColor="@color/delete_red"
                android:textSize="@dimen/text_caption"
                android:visibility="gone"
                tools:text="Schedule at least 15 minutes from now"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white_shadow"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="@string/checkout_order_summary"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_toolbar_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_secondary"
                    tools:text="Subtotal: $20.00" />

                <TextView
                    android:id="@+id/tvLoyaltyDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_secondary"
                    tools:text="Loyalty discount: -$5.00" />

                <TextView
                    android:id="@+id/tvPromoDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_secondary"
                    tools:text="Promo discount: -$1.50" />

                <TextView
                    android:id="@+id/tvFinalTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_navy_heading"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold"
                    tools:text="Final Total: $13.50" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnPlaceOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:background="@drawable/bg_button_primary"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:text="@string/checkout_place_order"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

</LinearLayout>
