<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance_CodeCup_ScreenTitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance_CodeCup_PageTitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_page_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance_CodeCup_SectionTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_section_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance_CodeCup_Body">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance_CodeCup_Secondary">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_secondary</item>
    </style>

    <style name="TextAppearance_CodeCup_Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="Widget_CodeCup_PrimaryButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget_CodeCup_IconButton">
        <item name="android:layout_width">@dimen/icon_lg</item>
        <item name="android:layout_height">@dimen/icon_lg</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/spacing_sm</item>
    </style>

    <style name="Widget_CodeCup_BottomNavigation">
        <item name="android:background">@drawable/bg_nav_floating_card</item>
        <item name="android:elevation">12dp</item>
        <item name="itemIconSize">@dimen/icon_md</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
